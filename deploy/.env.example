# Analytics warehouse (Morpho Blue Len)
POSTGRES_USER=morpho
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=morpho

# Metabase application database (stores Metabase users, settings, saved questions)
METABASE_DB_PASSWORD=change-me-strong-password

# HTTPS — set your domain and email for Let's Encrypt
METABASE_DOMAIN=metabase.example.com
ACME_EMAIL=admin@example.com

# Set to true to skip TLS and serve Metabase on port 80 only (IP access, no domain)
HTTP_ONLY=false

# Optional: pin Metabase version (default: latest)
# METABASE_VERSION=v0.53.4
